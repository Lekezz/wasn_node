      "Bash(wget:*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/lekej/Summer2026/mic_test/.claude/hooks/ioc_guard.py\"",
            "timeout": 20,
            "statusMessage": "Checking CubeMX regeneration guard"
          }
        ]
      }
    ]
  }
}