{
  "includeCoAuthoredBy": false,
  "gitAttribution": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Edit(./mic_test/Drivers/**)",
      "Write(./mic_test/Drivers/**)",
